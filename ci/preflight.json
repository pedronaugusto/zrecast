{
  "sources": ["src"],
  "test_roots": ["src/zrecast.zig"],
  "test_dependencies": ["shakedown"],
  "shipped": {
    "ffi": "the C boundary: the library compiles its translation units, and the installed header is ffi/zrecast.h",
    "libs": "the vendored Recast and Detour, which the library compiles"
  },
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": ["zrecast"]
    },
    "zig build measurements": {
      "command": ["zig", "build", "measurements"]
    }
  },
  "extra_checks": [
    ["zig", "build", "check-consumer"],
    ["zig", "build", "check-comments"],
    ["zig", "build", "check-coverage"],
    ["zig", "build", "check-ignored"],
    ["zig", "build", "check-numbers"],
    ["zig", "build", "check-vendor"]
  ],
  "fuzz": {
    "parsers": [
      "initFromBytes",
      "addTile",
      "restoreTileState",
      "validate",
      "tileLayout",
      "swapImageEndian",
      "swapTileCacheHeaderEndian"
    ],
    "trusted": {
      "readContourSet": "a dump this package wrote: upstream reads it field by field with no length to check a count against",
      "readCompactHeightfield": "a dump this package wrote: upstream reads it field by field with no length to check a count against"
    }
  },
  "glint_paths": ["src", "examples", "ci", "build.zig"],
  "glint": {
    "rules": [
      {"id": "P001", "level": "gate"},
      {"id": "P003", "level": "gate"},
      {"id": "Z026", "level": "gate"},
      {"id": "A001", "level": "gate"},
      {"id": "A002", "level": "gate"},
      {"id": "A003", "level": "gate"},
      {"id": "A004", "level": "gate"},
      {"id": "A005", "level": "gate"},
      {"id": "A006", "level": "gate"}
    ]
  }
}
